{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ekkus93/weachy-mini/models/manifests/local-llm-manifest.schema.json",
  "title": "Reachy Mini local LLM manifest",
  "description": "Schema version 1 describes one verified GGUF artifact for the first-party reachy_llama runtime. Provenance is metadata only; this manifest does not authorize a download, provider fallback, or network-dependent inference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "runtime",
    "artifact",
    "gguf_metadata",
    "inference",
    "device_compatibility"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "model_id",
        "display_name",
        "model_version",
        "source_uri",
        "source_revision",
        "license_id",
        "experimental",
        "experimental_reason"
      ],
      "properties": {
        "manifest_id": {
          "$ref": "#/$defs/identifier"
        },
        "model_id": {
          "$ref": "#/$defs/identifier"
        },
        "display_name": {
          "$ref": "#/$defs/text128"
        },
        "model_version": {
          "$ref": "#/$defs/text128"
        },
        "source_uri": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://[^/@#]+(?:/[^#]*)?(?:\\?[^#]*)?$"
        },
        "source_revision": {
          "$ref": "#/$defs/text128"
        },
        "license_id": {
          "$ref": "#/$defs/text128"
        },
        "experimental": {
          "type": "boolean"
        },
        "experimental_reason": {
          "type": "string",
          "maxLength": 512
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "experimental": {
                "const": true
              }
            },
            "required": [
              "experimental"
            ]
          },
          "then": {
            "properties": {
              "experimental_reason": {
                "minLength": 1,
                "pattern": ".*\\S.*"
              }
            }
          },
          "else": {
            "properties": {
              "experimental_reason": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_id",
        "abi_version",
        "requires_network_access"
      ],
      "properties": {
        "runtime_id": {
          "const": "reachy_llama"
        },
        "abi_version": {
          "const": 1
        },
        "requires_network_access": {
          "const": false
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "file_size_bytes",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 6,
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*:)[^/]+(?:/[^/]+)*\\.gguf$"
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "gguf_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gguf_version",
        "architecture",
        "quantization",
        "parameter_count",
        "tokenizer_model",
        "tokenizer_pre"
      ],
      "properties": {
        "gguf_version": {
          "type": "integer",
          "minimum": 1
        },
        "architecture": {
          "$ref": "#/$defs/text128"
        },
        "quantization": {
          "$ref": "#/$defs/text128"
        },
        "parameter_count": {
          "type": "integer",
          "minimum": 1
        },
        "tokenizer_model": {
          "$ref": "#/$defs/text128"
        },
        "tokenizer_pre": {
          "$ref": "#/$defs/text128"
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_limit_tokens",
        "chat_template",
        "stop_tokens",
        "memory_estimate",
        "recommended_threads"
      ],
      "properties": {
        "context_limit_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "chat_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": ".*\\S.*"
        },
        "stop_tokens": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": ".*\\S.*"
          }
        },
        "memory_estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "peak_ram_bytes",
            "basis_context_tokens",
            "basis_batch_tokens"
          ],
          "properties": {
            "peak_ram_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "basis_context_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "basis_batch_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "recommended_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "device_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "android_abis",
        "minimum_android_api",
        "required_cpu_features",
        "minimum_ram_bytes",
        "reachy_llama_abi_version"
      ],
      "properties": {
        "android_abis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "arm64-v8a"
          }
        },
        "minimum_android_api": {
          "type": "integer",
          "minimum": 26
        },
        "required_cpu_features": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "minimum_ram_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "reachy_llama_abi_version": {
          "const": 1
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "text128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": ".*\\S.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

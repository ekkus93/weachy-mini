             ("route-change-is-visible-and-cancels", RouteChangeIsVisible),
             ("phone-mode-is-visible-and-cancels", PhoneModeIsVisible),
             ("microphone-mute-is-visible-and-cancels", MicrophoneMuteIsVisible),

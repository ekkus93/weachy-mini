diff --git a/Assets/ReachyMini/Runtime/Application/ReachyAndroidMemoryPressureMonitor.cs b/Assets/ReachyMini/Runtime/Application/ReachyAndroidMemoryPressureMonitor.cs
new file mode 100644
index 0000000..6dc2451
--- /dev/null
+++ b/Assets/ReachyMini/Runtime/Application/ReachyAndroidMemoryPressureMonitor.cs
@@ -0,0 +1,189 @@
+#nullable enable
+
+using System;
+using System.Threading;
+using ReachyMini.AppState;
+using UnityEngine;
+
+namespace ReachyMini.LocalModels
+{
+    public static class ReachyAndroidMemoryPressureState
+    {
+        private static int level;
+        private static long revision;
+
+        public static ReachyMemoryPressureLevel CurrentLevel =>
+            (ReachyMemoryPressureLevel)Volatile.Read(ref level);
+
+        public static long Revision => Volatile.Read(ref revision);
+
+        public static void Report(ReachyMemoryPressureLevel pressureLevel)
+        {
+            if (!Enum.IsDefined(typeof(ReachyMemoryPressureLevel), pressureLevel))
+            {
+                throw new ArgumentOutOfRangeException(nameof(pressureLevel));
+            }
+
+            while (true)
+            {
+                int current = Volatile.Read(ref level);
+                if (current >= (int)pressureLevel)
+                {
+                    return;
+                }
+                if (Interlocked.CompareExchange(
+                        ref level,
+                        (int)pressureLevel,
+                        current) == current)
+                {
+                    Interlocked.Increment(ref revision);
+                    return;
+                }
+            }
+        }
+
+        public static void ObserveHealthySnapshot(
+            long availableMemoryBytes,
+            long lowMemoryThresholdBytes,
+            bool systemReportsLowMemory)
+        {
+            if (availableMemoryBytes < 0L || lowMemoryThresholdBytes < 0L)
+            {
+                throw new ArgumentOutOfRangeException(nameof(availableMemoryBytes));
+            }
+            if (systemReportsLowMemory)
+            {
+                return;
+            }
+
+            long recoveryThreshold = lowMemoryThresholdBytes > long.MaxValue / 2L
+                ? long.MaxValue
+                : lowMemoryThresholdBytes * 2L;
+            if (availableMemoryBytes <= recoveryThreshold)
+            {
+                return;
+            }
+
+            if (Interlocked.Exchange(
+                    ref level,
+                    (int)ReachyMemoryPressureLevel.Normal) !=
+                (int)ReachyMemoryPressureLevel.Normal)
+            {
+                Interlocked.Increment(ref revision);
+            }
+        }
+    }
+
+    public sealed class ReachyAndroidMemoryTrimMonitor : IDisposable
+    {
+        private readonly Action<ReachyMemoryPressureSignal> pressureObserved;
+#if UNITY_ANDROID && !UNITY_EDITOR
+        private readonly AndroidJavaObject activity;
+        private readonly ComponentCallbacksProxy callbacks;
+#endif
+        private bool disposed;
+
+        public ReachyAndroidMemoryTrimMonitor(
+            Action<ReachyMemoryPressureSignal> onPressureObserved)
+        {
+            pressureObserved = onPressureObserved ??
+                throw new ArgumentNullException(nameof(onPressureObserved));
+#if UNITY_ANDROID && !UNITY_EDITOR
+            activity = GetCurrentActivity();
+            callbacks = new ComponentCallbacksProxy(HandleTrimMemory, HandleLowMemory);
+            activity.Call("registerComponentCallbacks", callbacks);
+#endif
+        }
+
+        public void Dispose()
+        {
+            if (disposed)
+            {
+                return;
+            }
+            disposed = true;
+#if UNITY_ANDROID && !UNITY_EDITOR
+            try
+            {
+                activity.Call("unregisterComponentCallbacks", callbacks);
+            }
+            finally
+            {
+                callbacks.Dispose();
+                activity.Dispose();
+            }
+#endif
+            GC.SuppressFinalize(this);
+        }
+
+        private void HandleTrimMemory(int trimLevel)
+        {
+            if (disposed)
+            {
+                return;
+            }
+            ReachyMemoryPressureLevel level =
+                ReachyMemoryPressureSignal.ClassifyAndroidTrimLevel(trimLevel);
+            if (level == ReachyMemoryPressureLevel.Normal)
+            {
+                return;
+            }
+            pressureObserved(new ReachyMemoryPressureSignal(
+                level,
+                ReachyMemoryPressureSource.AndroidTrimMemory,
+                trimLevel));
+        }
+
+        private void HandleLowMemory()
+        {
+            if (disposed)
+            {
+                return;
+            }
+            pressureObserved(new ReachyMemoryPressureSignal(
+                ReachyMemoryPressureLevel.Critical,
+                ReachyMemoryPressureSource.AndroidLowMemory));
+        }
+
+#if UNITY_ANDROID && !UNITY_EDITOR
+        private static AndroidJavaObject GetCurrentActivity()
+        {
+            using var unityPlayer =
+                new AndroidJavaClass("com.unity3d.player.UnityPlayer");
+            return unityPlayer.GetStatic<AndroidJavaObject>("currentActivity") ??
+                throw new InvalidOperationException(
+                    "Unity did not expose an Android currentActivity.");
+        }
+
+        private sealed class ComponentCallbacksProxy : AndroidJavaProxy
+        {
+            private readonly Action<int> trimMemory;
+            private readonly Action lowMemory;
+
+            public ComponentCallbacksProxy(
+                Action<int> onTrimMemory,
+                Action onLowMemory)
+                : base("android.content.ComponentCallbacks2")
+            {
+                trimMemory = onTrimMemory;
+                lowMemory = onLowMemory;
+            }
+
+            public void onTrimMemory(int level)
+            {
+                trimMemory(level);
+            }
+
+            public void onLowMemory()
+            {
+                lowMemory();
+            }
+
+            public void onConfigurationChanged(AndroidJavaObject configuration)
+            {
+                _ = configuration;
+            }
+        }
+#endif
+    }
+}
diff --git a/Assets/ReachyMini/Runtime/Application/ReachyDiagnosticBundleStorageGate.cs b/Assets/ReachyMini/Runtime/Application/ReachyDiagnosticBundleStorageGate.cs
new file mode 100644
index 0000000..6b84e67
--- /dev/null
+++ b/Assets/ReachyMini/Runtime/Application/ReachyDiagnosticBundleStorageGate.cs
@@ -0,0 +1,35 @@
+#nullable enable
+
+using System;
+
+namespace ReachyMini.AppState
+{
+    internal sealed class ReachyDiagnosticBundleStorageGate
+    {
+        private readonly string outputDirectory;
+        private readonly IReachyStorageSpaceProbe storageProbe;
+
+        public ReachyDiagnosticBundleStorageGate(
+            string diagnosticOutputDirectory,
+            IReachyStorageSpaceProbe? probe = null)
+        {
+            if (string.IsNullOrWhiteSpace(diagnosticOutputDirectory))
+            {
+                throw new ArgumentException(
+                    "Diagnostic storage gates require an output directory.",
+                    nameof(diagnosticOutputDirectory));
+            }
+            outputDirectory = diagnosticOutputDirectory;
+            storageProbe = probe ?? new ReachyDriveStorageSpaceProbe();
+        }
+
+        public ReachyStorageSpaceCheck Check()
+        {
+            return ReachyStorageSpaceCheck.Evaluate(
+                storageProbe,
+                outputDirectory,
+                ReachyStoragePressurePolicy.DiagnosticExportWriteBudgetBytes,
+                ReachyStoragePressurePolicy.DiagnosticExportSafetyReserveBytes);
+        }
+    }
+}

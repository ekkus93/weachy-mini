diff --git a/Assets/ReachyMini/Runtime/Application/ReachyMainScreen.StorageCleanup.cs b/Assets/ReachyMini/Runtime/Application/ReachyMainScreen.StorageCleanup.cs
new file mode 100644
index 0000000..2263c44
--- /dev/null
+++ b/Assets/ReachyMini/Runtime/Application/ReachyMainScreen.StorageCleanup.cs
@@ -0,0 +1,48 @@
+#nullable enable
+
+using System;
+
+namespace ReachyMini.AppState
+{
+    public sealed partial class ReachyMainScreen
+    {
+        private Func<ReachyStorageCleanupOutcome>? storageCleanupOperation;
+        private string storageCleanupStatus =
+            "Storage cleanup has not been run. Verified installed models are never removed automatically.";
+
+        public string StorageCleanupStatus => storageCleanupStatus;
+
+        public void ConfigureStorageCleanup(
+            Func<ReachyStorageCleanupOutcome> cleanupOperation)
+        {
+            if (storageCleanupOperation != null)
+            {
+                throw new InvalidOperationException(
+                    "The storage cleanup operation cannot be bound more than once.");
+            }
+            storageCleanupOperation = cleanupOperation ??
+                throw new ArgumentNullException(nameof(cleanupOperation));
+        }
+
+        public ReachyStorageCleanupOutcome CleanupStorage()
+        {
+            Func<ReachyStorageCleanupOutcome>? cleanup = storageCleanupOperation;
+            if (cleanup == null)
+            {
+                var unavailable = new ReachyStorageCleanupOutcome(
+                    false,
+                    0L,
+                    0,
+                    "Storage cleanup is unavailable because no cleanup coordinator is bound.");
+                storageCleanupStatus = unavailable.Detail;
+                return unavailable;
+            }
+
+            ReachyStorageCleanupOutcome outcome = cleanup();
+            storageCleanupStatus = outcome.Succeeded
+                ? outcome.Detail + " Freed " + outcome.BytesFreed + " bytes."
+                : outcome.Detail;
+            return outcome;
+        }
+    }
+}
diff --git a/Assets/ReachyMini/Runtime/Application/ReachyStoragePressureCleanupCoordinator.cs b/Assets/ReachyMini/Runtime/Application/ReachyStoragePressureCleanupCoordinator.cs
new file mode 100644
index 0000000..8f38d65
--- /dev/null
+++ b/Assets/ReachyMini/Runtime/Application/ReachyStoragePressureCleanupCoordinator.cs
@@ -0,0 +1,188 @@
+#nullable enable
+
+using System;
+using System.Collections.Generic;
+using System.IO;
+using ReachyMini.LocalModels;
+
+namespace ReachyMini.AppState
+{
+    public sealed class ReachyStorageCleanupOutcome
+    {
+        public ReachyStorageCleanupOutcome(
+            bool succeeded,
+            long bytesFreed,
+            int removedEntries,
+            string detail)
+        {
+            if (bytesFreed < 0L)
+            {
+                throw new ArgumentOutOfRangeException(nameof(bytesFreed));
+            }
+            if (removedEntries < 0)
+            {
+                throw new ArgumentOutOfRangeException(nameof(removedEntries));
+            }
+            if (string.IsNullOrWhiteSpace(detail))
+            {
+                throw new ArgumentException(
+                    "Storage cleanup outcomes require detail.",
+                    nameof(detail));
+            }
+
+            Succeeded = succeeded;
+            BytesFreed = bytesFreed;
+            RemovedEntries = removedEntries;
+            Detail = detail.Trim();
+        }
+
+        public bool Succeeded { get; }
+
+        public long BytesFreed { get; }
+
+        public int RemovedEntries { get; }
+
+        public string Detail { get; }
+    }
+
+    internal sealed class ReachyStoragePressureCleanupCoordinator
+    {
+        private const string DiagnosticPrefix = "reachy-diagnostics-";
+        private const string DiagnosticExtension = ".zip";
+
+        private readonly string diagnosticDirectory;
+        private readonly string localModelStoreRoot;
+
+        public ReachyStoragePressureCleanupCoordinator(
+            string diagnosticOutputDirectory,
+            string managedLocalModelStoreRoot)
+        {
+            if (string.IsNullOrWhiteSpace(diagnosticOutputDirectory))
+            {
+                throw new ArgumentException(
+                    "Storage cleanup requires the diagnostic output directory.",
+                    nameof(diagnosticOutputDirectory));
+            }
+            if (string.IsNullOrWhiteSpace(managedLocalModelStoreRoot))
+            {
+                throw new ArgumentException(
+                    "Storage cleanup requires the managed local-model root.",
+                    nameof(managedLocalModelStoreRoot));
+            }
+
+            diagnosticDirectory = Path.GetFullPath(diagnosticOutputDirectory);
+            localModelStoreRoot = Path.GetFullPath(managedLocalModelStoreRoot);
+        }
+
+        public ReachyStorageCleanupOutcome Cleanup()
+        {
+            try
+            {
+                long bytesFreed = 0L;
+                int removedEntries = 0;
+
+                CleanupOldDiagnosticBundles(ref bytesFreed, ref removedEntries);
+                ReachyStorageCleanupOutcome modelCleanup = CleanupLocalModelTransients();
+                if (!modelCleanup.Succeeded)
+                {
+                    return new ReachyStorageCleanupOutcome(
+                        false,
+                        bytesFreed,
+                        removedEntries,
+                        modelCleanup.Detail);
+                }
+                bytesFreed = checked(bytesFreed + modelCleanup.BytesFreed);
+                removedEntries = checked(
+                    removedEntries + modelCleanup.RemovedEntries);
+
+                return new ReachyStorageCleanupOutcome(
+                    true,
+                    bytesFreed,
+                    removedEntries,
+                    "Safe app-storage cleanup completed. Verified installed models and the newest diagnostic bundles were preserved.");
+            }
+            catch (IOException exception)
+            {
+                return Failure(exception);
+            }
+            catch (UnauthorizedAccessException exception)
+            {
+                return Failure(exception);
+            }
+        }
+
+        private void CleanupOldDiagnosticBundles(
+            ref long bytesFreed,
+            ref int removedEntries)
+        {
+            if (!Directory.Exists(diagnosticDirectory))
+            {
+                return;
+            }
+
+            string[] files = Directory.GetFiles(
+                diagnosticDirectory,
+                DiagnosticPrefix + "*" + DiagnosticExtension,
+                SearchOption.TopDirectoryOnly);
+            var candidates = new List<FileInfo>(files.Length);
+            for (int index = 0; index < files.Length; ++index)
+            {
+                var info = new FileInfo(files[index]);
+                if ((info.Attributes & FileAttributes.ReparsePoint) != 0)
+                {
+                    continue;
+                }

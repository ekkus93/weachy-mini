         }
 
+        public LocalModelTransientCleanupReport CleanupTransientStorage()
+        {
+            ThrowIfDisposed();
+            if (!operationGate.Wait(0))
+            {
+                return new LocalModelTransientCleanupReport(
+                    false,
+                    LocalModelPackageFailure.OperationBusy,
+                    "Transient local-model cleanup was deferred because a package operation is active.",
+                    0,
+                    0L);
+            }
+
+            try
+            {
+                LocalModelPackageResult? readiness = EnsureStoreReady();
+                if (readiness != null)
+                {
+                    return new LocalModelTransientCleanupReport(
+                        false,
+                        readiness.Failure,
+                        readiness.Detail,
+                        0,
+                        0L);
+                }
+
+                long bytesBefore = checked(
+                    MeasureManagedTreeBytes(stagingRoot) +
+                    MeasureManagedTreeBytes(quarantineRoot));
+                int removed =
+                    RemoveAllChildrenNoFollow(stagingRoot, CancellationToken.None) +
+                    RemoveAllChildrenNoFollow(quarantineRoot, CancellationToken.None);
+                return new LocalModelTransientCleanupReport(
+                    true,
+                    LocalModelPackageFailure.None,
+                    "Transient local-model staging and quarantine data were removed; installed verified models were preserved.",
+                    removed,
+                    bytesBefore);
+            }
+            catch (IOException exception)
+            {
+                return new LocalModelTransientCleanupReport(
+                    false,
+                    LocalModelPackageFailure.IoFailure,
+                    SafeIoDetail("Transient local-model cleanup failed", exception),
+                    0,
+                    0L);
+            }
+            catch (UnauthorizedAccessException exception)
+            {
+                return new LocalModelTransientCleanupReport(
+                    false,
+                    LocalModelPackageFailure.IoFailure,
+                    SafeIoDetail("Transient local-model cleanup was denied", exception),
+                    0,
+                    0L);
+            }
+            finally
+            {
+                operationGate.Release();
+            }
+        }
+
+        private long MeasureManagedTreeBytes(string directory)
+        {
+            if (!Directory.Exists(directory))
+            {
+                return 0L;
+            }
+
+            long total = 0L;
+            var pending = new Stack<string>();
+            pending.Push(directory);
+            while (pending.Count > 0)
+            {
+                string current = pending.Pop();
+                string[] entries = Directory.GetFileSystemEntries(current);
+                for (int index = 0; index < entries.Length; ++index)
+                {
+                    string entry = RequireContainedPath(entries[index]);
+                    if (IsReparsePoint(entry))
+                    {
+                        continue;
+                    }
+                    if (Directory.Exists(entry))
+                    {
+                        pending.Push(entry);
+                    }
+                    else if (File.Exists(entry))
+                    {
+                        total = checked(total + new FileInfo(entry).Length);
+                    }
+                }
+            }
+            return total;
+        }
+

+    public sealed class LocalModelTransientCleanupReport
+    {
+        internal LocalModelTransientCleanupReport(
+            bool succeeded,
+            LocalModelPackageFailure failure,
+            string detail,
+            int removedEntries,
+            long bytesFreed)
+        {
+            if (removedEntries < 0)
+            {
+                throw new ArgumentOutOfRangeException(nameof(removedEntries));
+            }
+            if (bytesFreed < 0L)
+            {
+                throw new ArgumentOutOfRangeException(nameof(bytesFreed));
+            }
+
+            Succeeded = succeeded;
+            Failure = failure;
+            Detail = detail ?? string.Empty;
+            RemovedEntries = removedEntries;
+            BytesFreed = bytesFreed;
+        }
+
+        public bool Succeeded { get; }
+
+        public LocalModelPackageFailure Failure { get; }
+
+        public string Detail { get; }
+
+        public int RemovedEntries { get; }
+
+        public long BytesFreed { get; }
+    }
+
 }

diff --git a/Assets/ReachyMini/Runtime/Core/LocalModels/ReachyLocalLlmProvider.MemoryPressure.cs b/Assets/ReachyMini/Runtime/Core/LocalModels/ReachyLocalLlmProvider.MemoryPressure.cs
new file mode 100644
index 0000000..850efdb
--- /dev/null
+++ b/Assets/ReachyMini/Runtime/Core/LocalModels/ReachyLocalLlmProvider.MemoryPressure.cs
@@ -0,0 +1,150 @@
+#nullable enable
+
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using ReachyMini.AppState;
+using ReachyMini.Interop;
+
+namespace ReachyMini.LocalModels
+{
+    public sealed partial class LocalLlmProvider : IReachyMemoryPressureTarget
+    {
+        public string MemoryPressureTargetId => "local-llm-model";
+
+        public async ValueTask<ReachyMemoryPressureTargetResult>
+            ApplyMemoryPressureAsync(ReachyMemoryPressureSignal signal)
+        {
+            if (signal == null)
+            {
+                throw new ArgumentNullException(nameof(signal));
+            }
+            if (signal.Level != ReachyMemoryPressureLevel.Critical)
+            {
+                return new ReachyMemoryPressureTargetResult(
+                    MemoryPressureTargetId,
+                    succeeded: true,
+                    releasedResources: false,
+                    "The loaded local LLM is retained below critical memory pressure.");
+            }
+
+            Task<LocalLlmGenerationResult>? activeTask;
+            CancellationTokenSource? cancellation;
+            lock (sync)
+            {
+                if (state == LocalLlmProviderState.Disposed)
+                {
+                    return new ReachyMemoryPressureTargetResult(
+                        MemoryPressureTargetId,
+                        succeeded: true,
+                        releasedResources: false,
+                        "The local LLM provider is already disposed.");
+                }
+                if (memoryPressureReleasePending)
+                {
+                    return new ReachyMemoryPressureTargetResult(
+                        MemoryPressureTargetId,
+                        succeeded: true,
+                        releasedResources: false,
+                        "A local LLM memory-pressure release is already active.");
+                }
+                if (state == LocalLlmProviderState.Loading)
+                {
+                    return new ReachyMemoryPressureTargetResult(
+                        MemoryPressureTargetId,
+                        succeeded: false,
+                        releasedResources: false,
+                        "Critical memory-pressure release was deferred because a local LLM model lifecycle operation is active.");
+                }
+
+                memoryPressureReleasePending = true;
+                memoryPressureReleaseCompletion = new TaskCompletionSource<bool>(
+                    TaskCreationOptions.RunContinuationsAsynchronously);
+                conversationEpoch = NextEpoch(conversationEpoch);
+                cancellation = activeCancellation;
+                activeTask = activeGenerationTask;
+                cancellation?.Cancel();
+            }
+
+            try
+            {
+                if (activeTask != null)
+                {
+                    await activeTask.ConfigureAwait(false);
+                }
+
+                ulong handle;
+                lock (sync)
+                {
+                    if (state == LocalLlmProviderState.Disposed)
+                    {
+                        return new ReachyMemoryPressureTargetResult(
+                            MemoryPressureTargetId,
+                            succeeded: true,
+                            releasedResources: false,
+                            "The local LLM provider was disposed while pressure release was draining.");
+                    }
+                    handle = modelHandle;
+                    if (handle == 0UL)
+                    {
+                        state = LocalLlmProviderState.Unavailable;
+                        return new ReachyMemoryPressureTargetResult(
+                            MemoryPressureTargetId,
+                            succeeded: true,
+                            releasedResources: false,
+                            "No loaded local LLM model remained to release.");
+                    }
+                    // Claim this handle before crossing the async unload boundary.
+                    // DisposeAsync can then observe that pressure release owns the
+                    // native unload and wait for its completion instead of double-unloading.
+                    modelHandle = 0UL;
+                    state = LocalLlmProviderState.Loading;
+                }
+
+                LocalLlmRuntimeCallResult unload = await Task.Run(
+                    () => runtime.UnloadModel(handle),
+                    CancellationToken.None).ConfigureAwait(false);
+                lock (sync)
+                {
+                    if (state != LocalLlmProviderState.Disposed)
+                    {
+                        if (unload.Succeeded)
+                        {
+                            modelHandle = 0UL;
+                            state = LocalLlmProviderState.Unavailable;
+                        }
+                        else
+                        {
+                            modelHandle = handle;
+                            state = LocalLlmProviderState.Faulted;
+                        }
+                    }
+                }
+
+                return unload.Succeeded
+                    ? new ReachyMemoryPressureTargetResult(
+                        MemoryPressureTargetId,
+                        succeeded: true,
+                        releasedResources: true,
+                        "The optional local LLM model was unloaded after active generation drained.")
+                    : new ReachyMemoryPressureTargetResult(
+                        MemoryPressureTargetId,
+                        succeeded: false,
+                        releasedResources: false,
+                        "The local LLM runtime could not unload the model under memory pressure (" +
+                        unload.Status + ").");
+            }
+            finally
+            {
+                TaskCompletionSource<bool>? completion;
+                lock (sync)
+                {
+                    memoryPressureReleasePending = false;
+                    completion = memoryPressureReleaseCompletion;
+                    memoryPressureReleaseCompletion = null;
+                }
+                completion?.TrySetResult(true);
+            }
+        }
+    }
+}

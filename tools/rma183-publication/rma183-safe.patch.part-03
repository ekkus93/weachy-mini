@@ -0,0 +1,58 @@
+# RMA-183 Local Validation — Memory and Storage Pressure
+
+Date: 2026-08-15
+
+## Scope
+
+This record covers sandbox validation of RMA-183 before publication. It is software evidence only; no physical Android low-memory callback, storage exhaustion, thermal run, or device profiling is claimed.
+
+## Covered behavior
+
+- Android `ComponentCallbacks2` and Unity low-memory ingress are present and feed a coalesced pressure path.
+- Callback pressure augments the existing RMA-135 Android memory snapshot rather than replacing its thresholds.
+- Unity unused-asset release is initiated from the Unity host update path.
+- Critical local-LLM pressure cancels/drains active generation, serializes unload ownership against disposal, unloads the optional model, and leaves the provider explicitly unavailable until explicit reload.
+- Package downloads re-check free space before every write chunk and preserve resumable partial state on mid-stream storage exhaustion.
+- Transient package cleanup removes staging/quarantine state only and preserves verified installed models.
+- Diagnostic export performs a fail-closed storage preflight using a 16 MiB write budget plus 64 MiB reserve.
+- The cleanup UI removes only owned package transients and old diagnostic ZIPs while retaining the newest three diagnostic bundles.
+
+## Managed contract sources
+
+The following managed contracts were added or extended for the hosted warnings-as-errors gate:
+
+- `managed/ReachyMini.Core.Tests/Rma183ResourcePressureContractTests.cs`
+  - Android trim-level classification;
+  - coordinator continuation/failure accounting;
+  - storage headroom boundary behavior.
+- `managed/ReachyMini.LocalLlm.Tests/Program.MemoryPressureTests.cs`
+  - moderate pressure retains the model;
+  - critical pressure unloads it;
+  - generation stays unavailable afterward;
+  - explicit reload restores service.
+- `managed/ReachyMini.LocalModelPackages.Tests/Program.cs`
+  - mid-stream storage exhaustion leaves the exact resumable offset;
+  - a later attempt resumes and completes;
+  - transient cleanup preserves an installed verified model.
+
+## Local commands
+
+Final local commands and results after the implementation and roadmap update:
+
+```bash
+python3 scripts/tests/test_rma183_memory_storage_pressure.py
+# Ran 7 tests: OK
+
+python3 -m unittest discover -s scripts/tests -p 'test_*.py'
+# Ran 349 tests: OK
+
+git diff --check
+# clean
+
+TERM=xterm bash scripts/ci.sh --static-only
+# The sandbox terminated this long-running wrapper at its 600-second execution
+# ceiling while it was still emitting passing checks. No failure was observed
+# before termination, but a completed wrapper pass is not claimed.
+```
+
+The sandbox does not provide `dotnet`; therefore no local managed analyzer/build pass is claimed. GitHub publication is gated on the relevant managed projects with `TreatWarningsAsErrors=true` and `AnalysisLevel=latest-recommended`.
diff --git a/managed/ReachyMini.Core.Tests/Rma183ResourcePressureContractTests.cs b/managed/ReachyMini.Core.Tests/Rma183ResourcePressureContractTests.cs
new file mode 100644
index 0000000..b6ff2b6
--- /dev/null
+++ b/managed/ReachyMini.Core.Tests/Rma183ResourcePressureContractTests.cs
@@ -0,0 +1,154 @@
+#nullable enable
+
+using System;
+using System.Collections.Generic;
+using System.Threading.Tasks;
+using ReachyMini.AppState;
+
+namespace ReachyMini.Core.Tests
+{
+    internal static class Rma183ResourcePressureContractTests
+    {
+        public static void RunAll()
+        {
+            TestAndroidTrimClassification();
+            TestCoordinatorContinuesAfterTargetFailure();
+            TestStorageHeadroomCheck();
+        }
+
+        private static void TestAndroidTrimClassification()
+        {
+            Equal(
+                ReachyMemoryPressureLevel.Moderate,
+                ReachyMemoryPressureSignal.ClassifyAndroidTrimLevel(10),
+                "Android running-low classification");
+            Equal(
+                ReachyMemoryPressureLevel.Critical,
+                ReachyMemoryPressureSignal.ClassifyAndroidTrimLevel(15),
+                "Android running-critical classification");
+            Equal(
+                ReachyMemoryPressureLevel.Normal,
+                ReachyMemoryPressureSignal.ClassifyAndroidTrimLevel(20),
+                "Android UI-hidden classification");
+            Equal(
+                ReachyMemoryPressureLevel.Critical,
+                ReachyMemoryPressureSignal.ClassifyAndroidTrimLevel(80),
+                "Android complete classification");
+        }
+
+        private static void TestCoordinatorContinuesAfterTargetFailure()
+        {
+            var calls = new List<string>();
+            using var coordinator = new ReachyMemoryPressureCoordinator(
+                new IReachyMemoryPressureTarget[]
+                {
+                    new RecordingTarget("cache", calls, releases: true),
+                    new ThrowingTarget("fault", calls),
+                    new RecordingTarget("model", calls, releases: true),
+                });
+
+            ReachyMemoryPressureReport report = coordinator.ApplyAsync(
+                new ReachyMemoryPressureSignal(
+                    ReachyMemoryPressureLevel.Critical,
+                    ReachyMemoryPressureSource.AndroidLowMemory))
+                .GetAwaiter()
+                .GetResult();
+
+            Equal(3, report.Results.Count, "pressure result count");
+            Equal(1, report.FailureCount, "pressure failure count");
+            Equal(2, report.ReleasedTargetCount, "pressure release count");
+            Equal("cache,fault,model", string.Join(",", calls), "pressure target order");
+        }
+
+        private static void TestStorageHeadroomCheck()
+        {
+            ReachyStorageSpaceCheck insufficient = ReachyStorageSpaceCheck.Evaluate(
+                new FixedStorageProbe(99L),
+                "/tmp",
+                bytesToWrite: 40L,
+                safetyReserveBytes: 60L);
+            Equal(false, insufficient.Succeeded, "storage reserve rejection");
+            Equal(100L, insufficient.RequiredBytes, "storage required bytes");
+
+            ReachyStorageSpaceCheck sufficient = ReachyStorageSpaceCheck.Evaluate(
+                new FixedStorageProbe(100L),
+                "/tmp",
+                bytesToWrite: 40L,
+                safetyReserveBytes: 60L);
+            Equal(true, sufficient.Succeeded, "storage exact headroom acceptance");
+        }
+
+        private static void Equal<T>(T expected, T actual, string detail)
+        {
+            if (!EqualityComparer<T>.Default.Equals(expected, actual))
+            {
+                throw new InvalidOperationException(
+                    detail + ": expected " + expected + ", got " + actual + ".");
+            }
+        }
+
+        private sealed class FixedStorageProbe : IReachyStorageSpaceProbe
+        {
+            private readonly long availableBytes;
+
+            public FixedStorageProbe(long availableBytes)
+            {
+                this.availableBytes = availableBytes;
+            }
+
+            public long GetAvailableBytes(string path)
+            {
+                return availableBytes;
+            }
+        }
+
+        private sealed class RecordingTarget : IReachyMemoryPressureTarget
+        {
+            private readonly List<string> calls;
+            private readonly bool releases;
+
+            public RecordingTarget(
+                string targetId,
+                List<string> calls,
+                bool releases)
+            {
+                MemoryPressureTargetId = targetId;
+                this.calls = calls;
+                this.releases = releases;
+            }
+
+            public string MemoryPressureTargetId { get; }
+

+        private sealed class SequenceStorageProbe : ILocalModelStorageProbe
+        {
+            private readonly Queue<long> availableBytes;
+            private long lastValue;
+
+            public SequenceStorageProbe(params long[] values)
+            {
+                if (values == null || values.Length == 0)
+                {
+                    throw new ArgumentException("Storage probe sequence cannot be empty.", nameof(values));
+                }
+                availableBytes = new Queue<long>(values);
+                lastValue = values[values.Length - 1];
+            }
+
+            public long GetAvailableBytes(string managedStoreRoot)
+            {
+                Require(Path.IsPathRooted(managedStoreRoot), "storage probe path not rooted");
+                if (availableBytes.Count > 0)
+                {
+                    lastValue = availableBytes.Dequeue();
+                }
+                return lastValue;
+            }
+        }
+
         private sealed class ScriptedTransport : ILocalModelDownloadTransport

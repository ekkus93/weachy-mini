+                Require(
+                    new FileInfo(partPath).Length == LocalModelPackagePolicy.CopyBufferBytes,
+                    "Storage pressure wrote bytes after the failing storage re-check.");
+
+                LocalModelPackageResult resumed = await context.Manager.DownloadAsync(

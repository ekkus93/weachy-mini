+                    bytes[index] = checked((byte)(index % 251));
+                }
+                LocalModelManifest manifest = CreateManifest(artifactBytes: bytes);
+                var probe = new SequenceStorageProbe(
+                    long.MaxValue,
+                    long.MaxValue,
+                    0L,
+                    long.MaxValue,
+                    long.MaxValue);
+                using var context = new TestContext(root, Manager(root, probe));
+                var requestedOffsets = new List<long>();
+                var transport = new ScriptedTransport(
+                    (uri, offset) =>
+                    {
+                        requestedOffsets.Add(offset);
+                        int start = checked((int)offset);
+                        var remaining = new byte[bytes.Length - start];
+                        Buffer.BlockCopy(bytes, start, remaining, 0, remaining.Length);
+                        return Response(remaining, offset, bytes.Length);
+                    });
+

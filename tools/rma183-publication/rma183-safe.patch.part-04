+                        ArtifactUri("large-model.gguf"),
+                        transport,
+                        CancellationToken.None)
+                    .ConfigureAwait(false);
+                Require(resumed.Succeeded, resumed.Detail);
+                Require(resumed.Resumed, "Recovered download did not resume the retained partial.");
+                Require(
+                    requestedOffsets.Count == 2 &&
+                    requestedOffsets[0] == 0L &&
+                    requestedOffsets[1] == LocalModelPackagePolicy.CopyBufferBytes,
+                    "Recovered download did not request the exact retained offset.");
+            }
+            finally
+            {
+                if (Directory.Exists(root))
+                {
+                    Directory.Delete(root, recursive: true);
+                }
+            }
+        }

+            public ValueTask<ReachyMemoryPressureTargetResult> ApplyMemoryPressureAsync(
+                ReachyMemoryPressureSignal signal)
+            {
+                calls.Add(MemoryPressureTargetId);
+                return ValueTask.FromResult(new ReachyMemoryPressureTargetResult(
+                    MemoryPressureTargetId,
+                    succeeded: true,
+                    releasedResources: releases,
+                    "Synthetic pressure target completed."));
+            }
+        }
+
+        private sealed class ThrowingTarget : IReachyMemoryPressureTarget
+        {
+            private readonly List<string> calls;
+
+            public ThrowingTarget(string targetId, List<string> calls)
+            {
+                MemoryPressureTargetId = targetId;
+                this.calls = calls;
+            }
+
+            public string MemoryPressureTargetId { get; }
+
+            public ValueTask<ReachyMemoryPressureTargetResult> ApplyMemoryPressureAsync(
+                ReachyMemoryPressureSignal signal)
+            {
+                calls.Add(MemoryPressureTargetId);
+                throw new InvalidOperationException("synthetic pressure failure");
+            }
+        }
+    }
+}
diff --git a/managed/ReachyMini.LocalLlm.Tests/Program.MemoryPressureTests.cs b/managed/ReachyMini.LocalLlm.Tests/Program.MemoryPressureTests.cs
new file mode 100644
index 0000000..a3e199f
--- /dev/null
+++ b/managed/ReachyMini.LocalLlm.Tests/Program.MemoryPressureTests.cs
@@ -0,0 +1,61 @@
+#nullable enable
+
+using System.Threading;
+using System.Threading.Tasks;
+using ReachyMini.AppState;
+using ReachyMini.LocalModels;
+
+internal static partial class Program
+{
+    private static async Task TestCriticalMemoryPressureUnloadsModelAsync()
+    {
+        using var runtime = new FakeRuntime();
+        LocalLlmProvider provider = await CreateProviderAsync(runtime).ConfigureAwait(false);
+        try
+        {
+            ReachyMemoryPressureTargetResult moderate =
+                await provider.ApplyMemoryPressureAsync(
+                    new ReachyMemoryPressureSignal(
+                        ReachyMemoryPressureLevel.Moderate,
+                        ReachyMemoryPressureSource.AndroidTrimMemory,
+                        androidTrimLevel: 10));
+            Require(moderate.Succeeded, moderate.Detail);
+            Require(!moderate.ReleasedResources, "Moderate pressure unexpectedly unloaded the local LLM.");
+            Require(runtime.UnloadCount == 0, "Moderate pressure reached native unload.");
+
+            ReachyMemoryPressureTargetResult critical =
+                await provider.ApplyMemoryPressureAsync(
+                    new ReachyMemoryPressureSignal(
+                        ReachyMemoryPressureLevel.Critical,
+                        ReachyMemoryPressureSource.AndroidLowMemory));
+            Require(critical.Succeeded, critical.Detail);
+            Require(critical.ReleasedResources, "Critical pressure did not release the loaded local LLM.");
+            Require(runtime.UnloadCount == 1, "Critical pressure did not unload exactly one model handle.");
+            Require(
+                provider.State == LocalLlmProviderState.Unavailable,
+                "Provider did not become explicitly unavailable after pressure unload.");
+
+            LocalLlmGenerationResult unavailable = await provider.GenerateAsync(
+                    Request("memory-pressure-unloaded", "hello"),
+                    new CollectingSink(),
+                    CancellationToken.None)
+                .ConfigureAwait(false);
+            Require(
+                unavailable.Status == LocalLlmGenerationStatus.Unavailable,
+                "Generation silently continued after pressure unload.");
+
+            LocalLlmReloadResult reloaded = await provider.ReloadAsync(CancellationToken.None)
+                .ConfigureAwait(false);
+            Require(
+                reloaded.Status == LocalLlmReloadStatus.Reloaded,
+                "Explicit reload did not recover the pressure-unloaded provider.");
+        }
+        finally
+        {
+            await provider.DisposeAsync().ConfigureAwait(false);
+        }
+
+        Require(runtime.LoadCount == 2, "Pressure recovery did not perform exactly one explicit reload.");
+        Require(runtime.UnloadCount == 2, "Reloaded model was not released during disposal.");
+    }
+}
